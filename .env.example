# ==========================================
# 火鸟模式东南亚（菲律宾）环境变量预设配置表
# ==========================================

# 1. 基础服务
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# 2. Telegram Bot 配置 (通过 @BotFather 获取)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=FirebirdPHBot
TELEGRAM_MINI_APP_URL=https://t.me/FirebirdPHBot/app

# 3. 数据库与缓存
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/firebird_ph?schema=public
REDIS_URL=redis://localhost:6379

# 4. 菲律宾本地化基础设施
# Google Maps Platform (用于马尼拉/宿务等地的地理编码、外卖配送路径规划与距离计算)
GOOGLE_MAPS_API_KEY=AIzaSyD_EXAMPLE_GOOGLE_MAPS_KEY_PH
# Twilio / Sinch 国际短信网关 (支持 +63 手机号一键下发短信验证码)
TWILIO_ACCOUNT_SID=AC_EXAMPLE_ACCOUNT_SID
TWILIO_AUTH_TOKEN=EXAMPLE_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1234567890

# 5. USDT 支付与区块链节点
# 模式选择: "gateway" (MVP推荐三方网关) 或 "chain" (自建尾数监听)
USDT_SETTLEMENT_MODE=gateway
# 三方收单网关 (如 OxaPay / Cryptomus)
OXAPAY_MERCHANT_KEY=sandbox_oxapay_merchant_key
# 链上收单归集地址 (TRC-20 格式)
TRON_MASTER_RECEIVE_ADDRESS=TXYZ1234567890abcdefghijklmnopqrst
# TronGrid API 密钥 (用于轮询监听 TRC-20 USDT 转账交易)
TRONGRID_API_KEY=your-trongrid-api-key-here
# 动态尾数浮动过期时间 (分钟)
PAYMENT_WINDOW_MINUTES=15

# 6. 一人团队自动化集成 (n8n & 报警)
N8N_WEBHOOK_SECRET=your_n8n_secret_token
SENTRY_DSN=https://example@sentry.io/1234567
ALERT_TELEGRAM_CHAT_ID=-1001234567890
