# ==============================================================================
# 🔥 火鸟东南亚一人 AI 团队全套基建环境变量配置模版 (.env.example)
# ==============================================================================

# --- 1. Telegram 前哨 Bot 配置 ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_ADMIN_CHAT_ID=987654321
TG_BOT_PORT=3001
N8N_WEBHOOK_URL=http://localhost:5678/webhook/tg-input

# --- 2. n8n 自动化中枢 ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Manila

# --- 3. GitHub CI/CD 与 Project 看板 ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=arvin
GITHUB_REPO=firebird-sea
GITHUB_PROJECT_ID=1

# --- 4. Coins.ph 官方双币行情与鉴权 API ---
COINS_PH_BASE_URL=https://api.pro.coins.ph
COINS_PH_API_KEY=your_coins_ph_api_key_here
COINS_PH_API_SECRET=your_coins_ph_api_secret_here

# --- 4b. 收银台（Story 2.1，详见 docs/internal/CHECKOUT.md）---
# CHECKOUT_ENABLED=1   # 仅显式 =1 时开放 /tg-api/checkout；默认关闭（503）
# DB_TABLE_PREFIX=huoniao_   # 火鸟表前缀（pay_log 只读）
# DB_CLIENT=mariadb DB_HOST=... DB_PORT=3306 DB_USER=... DB_NAME=firebird_ph（密码走 DB_PASSWORD，勿提交）

# --- 5. Google Cloud & GKE 生产集群 ---
GCP_PROJECT_ID=firebird-gcp
GKE_CLUSTER_NAME=firebird-sea-cluster
GKE_LOCATION=asia-southeast1-a
GCP_SA_KEY='{"type": "service_account", "project_id": "firebird-gcp", ...}'

# --- 6. 数据库与缓存 ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=firebird_ph
MYSQL_USER=firebird
MYSQL_PASSWORD=firebirdpassword
REDIS_HOST=redis
REDIS_PORT=6379

# --- 7. 火鸟商业授权配置 ---
HUONIAO_LICENSE_DOMAIN=fh580.net
