# 邮件中继密钥模板 —— 这是模板，不是实际值。
#
# 后缀故意写成 .example，kustomize 的 resources 不包含它，
# ArgoCD 因此不会把它同步进集群（否则真密钥就又从 Git 泄漏一次）。
#
# 实际创建方式见 README.md「凭据轮换」。真实值只存在于集群 Secret 与
# 你的密码管理器里，永不进入 Git。
apiVersion: v1
kind: Secret
metadata:
  name: firebird-mail-secrets
  namespace: default
  labels:
    app: firebird-mail
type: Opaque
stringData:
  # SMTP AUTH 密码（server.js 在缺失时拒绝启动，即 fail-closed）
  smtp-pass: "<REPLACE_ME_smtp_password>"
  # Telegram bot token，用于邮件告警回推
  telegram-bot-token: "<REPLACE_ME_bot_token>"
  # 告警接收的 chat id
  telegram-chat-id: "<REPLACE_ME_chat_id>"
---
# TLS 私钥单独成 Secret，以 subPath 覆盖挂载到 /app/key.pem
apiVersion: v1
kind: Secret
metadata:
  name: firebird-mail-tls
  namespace: default
  labels:
    app: firebird-mail
type: Opaque
stringData:
  key.pem: |
    -----BEGIN PRIVATE KEY-----
    <REPLACE_ME_tls_private_key>
    -----END PRIVATE KEY-----
