# ==============================================================================
# 🔥 Coins.ph 汇率与中间件微服务 (Alpine 多阶段极小容器，安全非 Root & 极速构建)
# ==============================================================================

# Stage 1: Build & Prune (依赖下载与安装)
FROM node:20-alpine AS builder
WORKDIR /app

# 优先单独复制 package 定义，充分利用 Docker 缓存层
COPY services/api/package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi \
    && npm cache clean --force

# Stage 1b: TMA 前端构建（有 index.html 才构建；产物由 api 在 /tma/ 托管，不新增部署单元）
# VITE_GOOGLE_MAPS_API_KEY：构建期注入前端（Google Places 地址联想）；CI 用 secret 传入，缺省时前端自动降级为纯手输
FROM node:20-alpine AS tma-build
WORKDIR /tma
ARG VITE_GOOGLE_MAPS_API_KEY=""
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY
COPY apps/tma/ ./
RUN if [ -f index.html ]; then npm ci --no-audit --no-fund && npm run build; else mkdir -p dist; fi

# Stage 2: Minimal Runtime (安全无特权运行时)
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000

# TMA 登录映射/审计经 mariadb 命令行客户端写库（沿用「不引入 mysql2」，见 docs/internal/TMA_LOGIN_BRIDGE.md）
RUN apk add --no-cache mariadb-client

# 从构建层拷贝精简依赖与业务源码，统一收口为非 root 的 node 用户
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node services/api/src ./src
# 迁移脚本必须随镜像走：启动前自动执行，防止新环境缺表导致登录 502（2026-10-26 canary 实测）
COPY --chown=node:node services/api/migrations ./migrations
COPY --chown=node:node services/api/package.json ./
COPY --chown=node:node --from=tma-build /tma/dist ./tma
ENV TMA_STATIC_DIR=/app/tma

# 切换为标准无特权账号
USER node

EXPOSE 3000

# 容器原生健康检查探针
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/health || exit 1

# 启动前先跑数据库迁移（幂等：fbs_migrations 记账 + DDL IF NOT EXISTS）
CMD ["sh", "-c", "node src/migrate.js && exec node src/server.js"]
