# ==============================================================================
# 🔥 Coins.ph 汇率与中间件微服务 (Alpine 多阶段极小容器，安全非 Root & 极速构建)
# ==============================================================================

# Stage 1: Build & Prune (依赖下载与安装)
FROM node:20-alpine AS builder
WORKDIR /app

# 优先单独复制 package 定义，充分利用 Docker 缓存层
COPY services/api/package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi \
    && npm cache clean --force

# 注：TMA（Telegram Mini App）前端已于 2026-11-04 整体归档（docs/archive/tma-legacy-2026-11-04.tar.gz），
# 原 Stage 1b（COPY apps/tma/ + vite build）随之移除。这里不是「暂时注释掉」：
# apps/tma 目录已不存在，任何 COPY apps/tma 都会在 COPY 这一步直接失败，
# 后面那句 `if [ -f index.html ]` 的回退逻辑跑不到（COPY 先报错）——#189 的 blocker 就是这个。
# 前端如需复活，从归档包解出后需连同 tma-build 阶段一起恢复，不能只恢复目录。

# Stage 2: Minimal Runtime (安全无特权运行时)
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000

# TMA 登录映射/审计经 mariadb 命令行客户端写库（沿用「不引入 mysql2」，见 docs/internal/TMA_LOGIN_BRIDGE.md）
RUN apk add --no-cache mariadb-client

# 从构建层拷贝精简依赖与业务源码，统一收口为非 root 的 node 用户
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node services/api/src ./src
# 迁移脚本必须随镜像走：启动前自动执行，防止新环境缺表导致登录 502（2026-10-26 canary 实测）
COPY --chown=node:node services/api/migrations ./migrations
COPY --chown=node:node services/api/package.json ./
# TMA_STATIC_DIR 不再设置：镜像里没有 /app/tma。server.js 的静态托管有 existsSync 守卫，
# 目录不存在就不挂载 /tma 路由 —— 即 /tma 返回 404 而不是 500，API 其余端点不受影响。
# 保留守卫而不是删掉那段代码，是因为前端复活时只需恢复构建阶段，不必再改 server.js。

# 切换为标准无特权账号
USER node

EXPOSE 3000

# 容器原生健康检查探针
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/health || exit 1

# 启动前先跑数据库迁移（幂等：fbs_migrations 记账 + DDL IF NOT EXISTS）。
# DB 暂时不可达（如滚动期）时退避重试 3 次，仍失败才退出——避免瞬时抖动把整个 API 打崩循环重启（QA 147 轮 2 minor）
CMD ["sh", "-c", "ok=0; for i in 1 2 3; do if node src/migrate.js; then ok=1; break; fi; echo \"migrate failed, retry $i/3\"; sleep 5; done; [ \"$ok\" = 1 ] && exec node src/server.js || { echo 'migrate failed after 3 attempts'; exit 1; }"]
