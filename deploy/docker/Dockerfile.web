# ==============================================================================
# 🔥 火鸟门户 Web/PHP 业务镜像 (极速秒级构建层)
# 基于预编译不可变基础镜像 firebird-base，日常发版无需重复编译 PHP 扩展
# ==============================================================================

ARG BASE_IMAGE=asia-southeast1-docker.pkg.dev/fh580-70533/containers/firebird-base:7.4-r2
FROM ${BASE_IMAGE}

WORKDIR /var/www/html

# 采用 --chown 复制业务源码与商业证书
COPY --chown=www-data:www-data webroot/ /var/www/html/
COPY --chown=www-data:www-data license/huoniao.php /var/www/html/include/huoniao.php
COPY deploy/docker/entrypoint-web.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm"]
