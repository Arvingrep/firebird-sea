# ==============================================================================
# 🔥 火鸟门户基础运行镜像 (Firebird Base Runtime Image)
# 包含 PHP 7.4-FPM + Alpine + 所有系统级拓展与商业解密引擎底座
# 极少变更，提供给 Dockerfile.web 作为快速构建底座
# ==============================================================================

FROM php:7.4-fpm-alpine

# 1. 运行时依赖与编译依赖分离，编译完成后立即卸载构建工具以极致瘦身
RUN apk add --no-cache \
        curl \
        libpng \
        libjpeg-turbo \
        freetype \
        libzip \
        oniguruma \
    && apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        libpng-dev \
        libjpeg-turbo-dev \
        freetype-dev \
        libzip-dev \
        oniguruma-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo_mysql mysqli gd zip bcmath opcache \
    && pecl install redis-5.3.7 \
    && docker-php-ext-enable redis \
    && apk del .build-deps \
    && rm -rf /var/cache/apk/* /tmp/* /usr/share/man

# 2. 生产级 PHP、OPcache 与 Swoole Loader 商业授权配置
RUN { \
        echo 'opcache.memory_consumption=128'; \
        echo 'opcache.interned_strings_buffer=16'; \
        echo 'opcache.max_accelerated_files=20000'; \
        echo 'opcache.revalidate_freq=2'; \
        echo 'opcache.validate_timestamps=1'; \
        echo 'opcache.fast_shutdown=1'; \
        echo 'opcache.enable_cli=1'; \
    } > /usr/local/etc/php/conf.d/opcache-recommended.ini \
    && { \
        echo 'expose_php = Off'; \
        echo 'upload_max_filesize = 50M'; \
        echo 'post_max_size = 50M'; \
        echo 'memory_limit = 256M'; \
        echo 'log_errors = On'; \
        echo 'error_log = /proc/self/fd/2'; \
    } > /usr/local/etc/php/conf.d/production.ini \
    && { \
        echo '[www]'; \
        echo 'catch_workers_output = yes'; \
    } > /usr/local/etc/php-fpm.d/zz-stdout.conf

# 3. 固化底层火鸟/Swoole Loader 扩展到系统扩展目录，实现不可变基座
COPY webroot/huoniao.so /usr/local/lib/php/extensions/no-debug-non-zts-20190902/huoniao.so
RUN { \
        echo 'extension=huoniao.so'; \
        echo 'swoole_loader.license_files=/var/www/html/huoniao'; \
    } > /usr/local/etc/php/conf.d/docker-php-ext-swoole_loader.ini

WORKDIR /var/www/html
EXPOSE 9000
CMD ["php-fpm"]
