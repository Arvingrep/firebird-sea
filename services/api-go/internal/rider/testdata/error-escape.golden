<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light only">
<meta name="theme-color" content="#FFFFFF">
<title>操作失败</title>
<style>
  :root { color-scheme: light only; }
  html, body { background: #FFFFFF; color: #1F2328; }
  html { min-height: 100%; -webkit-text-size-adjust: 100%; }
  body { margin: 0; padding: 24px; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif; font-size: 16px; line-height: 1.6; }
h1 { font-size: 18px; margin: 0 0 12px; }
p { margin: 0 0 8px; }
code { color: #57606A; font-size: 13px; }
</style>
</head>
<body>
<h1>操作失败</h1>
<p>&lt;script&gt;alert(1)&lt;/script&gt; &amp; &quot;x&quot; &#39;y&#39;</p>
<p><code>E&lt;script&gt;&amp;&quot;&#39;</code></p>
</body>
</html>