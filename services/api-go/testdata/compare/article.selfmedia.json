{
  "$schema": "./schema.json",
  "service": "article",
  "action": "selfmedia",
  "cases": [
    { "name": "正常：默认参数（未登录 isfollow=0）", "method": "GET", "params": {}, "requiresLogin": false },
    { "name": "正常：type=1&orderby=time", "method": "GET", "params": {"type": "1", "orderby": "time"}, "requiresLogin": false },
    { "name": "正常：title 命中 + pageSize=5", "method": "GET", "params": {"title": "a", "pageSize": "5"}, "requiresLogin": false },
    { "name": "正常：cityid=1（customDataShare=1 恒不筛）", "method": "GET", "params": {"cityid": "1"}, "requiresLogin": false },
    { "name": "正常：from=4（已关注 isfollow=1）", "method": "GET", "params": {"from": "4"}, "requiresLogin": false },
    { "name": "正常：from=3（自己 isfollow=2）", "method": "GET", "params": {"from": "3"}, "requiresLogin": false },
    { "name": "正常：越界页（list 为空、pageInfo 仍在）", "method": "GET", "params": {"page": "2"}, "requiresLogin": false },
    { "name": "空结果：type=2 无数据", "method": "GET", "params": {"type": "2"}, "requiresLogin": false },
    { "name": "空结果：ac_field=999999", "method": "GET", "params": {"ac_field": "999999"}, "requiresLogin": false },
    { "name": "空结果：title 无匹配", "method": "GET", "params": {"title": "zzz_no_such_selfmedia_zzz"}, "requiresLogin": false },
    { "name": "参数错误：type=abc（截断为 0，不筛）", "method": "GET", "params": {"type": "abc"}, "requiresLogin": false },
    { "name": "参数错误：ac_field=0abc（截断为 0，不筛）", "method": "GET", "params": {"ac_field": "0abc"}, "requiresLogin": false },
    { "name": "参数错误：title=0（PHP 假值，不筛）", "method": "GET", "params": {"title": "0"}, "requiresLogin": false },
    { "name": "参数错误：orderby=TIME（非 time，按 weight）", "method": "GET", "params": {"orderby": "TIME"}, "requiresLogin": false },
    { "name": "参数错误：page=-1&pageSize=abc（取默认）", "method": "GET", "params": {"page": "-1", "pageSize": "abc"}, "requiresLogin": false },
    { "name": "参数错误：cityid=abc", "method": "GET", "params": {"cityid": "abc"}, "requiresLogin": false },
    { "name": "参数错误：POST page=-1（LIMIT 非法 → list 空）", "method": "POST", "params": {"page": "-1", "pageSize": "5"}, "requiresLogin": false },
    { "name": "参数错误：from=abc（SQL 报错 → 失败串为真 → isfollow=1，canary 实测）", "method": "GET", "params": {"from": "abc"}, "requiresLogin": false },
    { "name": "JSONP（GET）", "method": "GET", "params": {"callback": "jQuery123_456"}, "requiresLogin": false },
    { "name": "POST 表单 type=1", "method": "POST", "params": {"type": "1"}, "requiresLogin": false },
    { "name": "正常：from=3.0（数字串比较等于 userid → isfollow=2）", "method": "GET", "params": {"from": "3.0"}, "requiresLogin": false },
    { "name": "参数错误：from=4abc（SQL 报错 → 失败串为真 → isfollow=1）", "method": "GET", "params": {"from": "4abc"}, "requiresLogin": false },
    { "name": "参数错误：from=-5（不大于 -1 → isfollow=0）", "method": "GET", "params": {"from": "-5"}, "requiresLogin": false },
    { "name": "参数错误：from=1.5（非整数不命中 → isfollow=0）", "method": "GET", "params": {"from": "1.5"}, "requiresLogin": false },
    { "name": "未登录：from=undefined（ajax.php 改写为空 → 未登录 isfollow=0）", "method": "GET", "params": {"from": "undefined"}, "requiresLogin": false },
    { "name": "参数错误：POST pageSize=-5（totalPage=-0、list 空）", "method": "POST", "params": {"page": "-1", "pageSize": "-5"}, "requiresLogin": false }
  ]
}
