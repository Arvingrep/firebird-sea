{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PHP/Go 对比用例文件",
  "description": "文件名为 <service>.<action>.json；cmd/compare 同时请求 PHP 与 Go 并逐字段比对。忽略规则只能写在这里。",
  "type": "object",
  "required": ["service", "action", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "service": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "method"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "method": { "enum": ["GET", "POST"] },
          "params": {
            "description": "业务参数（不含 service、action）；GET 放查询串，POST 放表单。",
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "requiresLogin": { "type": "boolean", "default": false },
          "ignoreFields": {
            "description": "比对时忽略的字段路径，如 info.ts、info.list[].pubdate（[] 匹配数组任意下标）。",
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
