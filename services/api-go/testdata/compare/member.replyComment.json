{
  "$schema": "./schema.json",
  "service": "member",
  "action": "replyComment",
  "cases": [
    {
      "name": "未登录：无参数，登录门禁先拦（101 登录超时）",
      "method": "GET",
      "params": {},
      "requiresLogin": false,
      "ignoreFields": []
    },
    {
      "name": "未登录：带 id/content 也先撞登录门禁（没有 from 后门）",
      "method": "GET",
      "params": {
        "id": "5",
        "content": "hi"
      },
      "requiresLogin": false,
      "ignoreFields": []
    },
    {
      "name": "未登录：check=1 同样拦截，登录门禁先于参数门禁",
      "method": "GET",
      "params": {
        "id": "5",
        "content": "hi",
        "check": "1"
      },
      "requiresLogin": false,
      "ignoreFields": []
    },
    {
      "name": "未登录：id=0 归一成空串，仍是登录门禁先拦",
      "method": "GET",
      "params": {
        "id": "0",
        "content": "hi"
      },
      "requiresLogin": false,
      "ignoreFields": []
    },
    {
      "name": "未登录：POST content（H5 的姿势）同样拦截",
      "method": "POST",
      "params": {
        "id": "5",
        "content": "hi"
      },
      "requiresLogin": false,
      "ignoreFields": []
    }
  ]
}
