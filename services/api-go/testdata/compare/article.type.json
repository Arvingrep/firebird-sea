{
  "$schema": "./schema.json",
  "service": "article",
  "action": "type",
  "cases": [
    { "name": "正常：无参（mold=0 顶级分类）", "method": "GET", "params": {}, "requiresLogin": false, "ignoreFields": ["info[].url"] },
    { "name": "正常：son=0 且 pageSize=2", "method": "GET", "params": { "son": "0", "pageSize": "2" }, "requiresLogin": false, "ignoreFields": ["info[].url"] },
    { "name": "正常：分页 page=2&pageSize=2", "method": "GET", "params": { "page": "2", "pageSize": "2" }, "requiresLogin": false, "ignoreFields": ["info[].url"] },
    { "name": "正常：son=1 递归子分类", "method": "GET", "params": { "son": "1" }, "requiresLogin": false, "ignoreFields": ["info[].url", "info[].lower[].url", "info[].lower[].lower[].url"] },
    { "name": "空结果：mold=1", "method": "GET", "params": { "mold": "1" }, "requiresLogin": false, "ignoreFields": ["info[].url"] },
    { "name": "空结果：son=1&type=1（无子分类）", "method": "GET", "params": { "son": "1", "type": "1" }, "requiresLogin": false, "ignoreFields": ["info[].url"] },
    { "name": "参数错误：pageSize=abc（回到 10）", "method": "GET", "params": { "pageSize": "abc" }, "requiresLogin": false, "ignoreFields": ["info[].url"] },
    { "name": "参数错误：mold=abc&type=abc（截断为 0）", "method": "GET", "params": { "mold": "abc", "type": "abc" }, "requiresLogin": false, "ignoreFields": ["info[].url"] },
    { "name": "参数错误：page=-1&pageSize=0（取默认）", "method": "GET", "params": { "page": "-1", "pageSize": "0" }, "requiresLogin": false, "ignoreFields": ["info[].url"] },
    { "name": "POST 表单 son=0", "method": "POST", "params": { "son": "0" }, "requiresLogin": false, "ignoreFields": ["info[].url"] },
    { "name": "POST 表单 pageSize=0（POST 无 <=0 默认 → 1000，与 GET 的 10 不同）", "method": "POST", "params": { "pageSize": "0" }, "requiresLogin": false, "ignoreFields": ["info[].url"] },
    { "name": "POST 表单 page=0&pageSize=2（page 空 → 1）", "method": "POST", "params": { "page": "0", "pageSize": "2" }, "requiresLogin": false, "ignoreFields": ["info[].url"] },
    { "name": "POST 表单 pageSize=abc（(int)0 → 1000）", "method": "POST", "params": { "pageSize": "abc" }, "requiresLogin": false, "ignoreFields": ["info[].url"] }
  ]
}
