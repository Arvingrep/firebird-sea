    {"name": "登录态（需要登录）：type=1 仅直播礼物", "method": "GET", "params": {"type": "1"}, "requiresLogin": true, "ignoreFields": ["info.list[].url"]},
    {"name": "登录态（需要登录）：soure=article 仅会员打赏", "method": "GET", "params": {"soure": "article", "pageSize": "5"}, "requiresLogin": true, "ignoreFields": ["info.list[].url", "info.list[].userinfo.photo", "info.list[].userinfo.levelIcon", "info.list[].userinfo.iphome", "info.list[].userinfo.cookiePre"]},
    {"name": "登录态（需要登录）：date + price 过滤，totalmoney 同受影响", "method": "GET", "params": {"date": "2024-05", "price": "1,100"}, "requiresLogin": true, "ignoreFields": ["info.list[].url", "info.list[].userinfo.photo", "info.list[].userinfo.levelIcon", "info.list[].userinfo.iphome", "info.list[].userinfo.cookiePre"]}
