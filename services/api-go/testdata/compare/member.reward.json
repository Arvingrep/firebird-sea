    {"name": "未登录：page/pageSize 越界", "method": "GET", "params": {"page": "9", "pageSize": "2"}, "requiresLogin": false, "ignoreFields": []},
    {"name": "未登录：type=1 + soure=article（直接暂无数据）", "method": "GET", "params": {"type": "1", "soure": "article"}, "requiresLogin": false, "ignoreFields": []},
    {"name": "未登录：soure=live", "method": "GET", "params": {"soure": "live"}, "requiresLogin": false, "ignoreFields": []},
    {"name": "未登录：date 过滤", "method": "GET", "params": {"date": "2024-05"}, "requiresLogin": false, "ignoreFields": []},
    {"name": "未登录：price 过滤", "method": "GET", "params": {"price": "5,10"}, "requiresLogin": false, "ignoreFields": []},
    {"name": "未登录：POST 表单", "method": "POST", "params": {"page": "1", "pageSize": "2"}, "requiresLogin": false, "ignoreFields": []},
