  {
   "name": "keywords + 经纬度",
   "method": "GET",
   "params": {
    "keywords": "旅游",
    "lng": "120.1",
    "lat": "30.2"
   }
  },
  {
   "name": "keywords + 分页",
   "method": "GET",
   "params": {
    "keywords": "旅游",
    "page": "2",
    "pageSize": "5"
   }
  }
 ]
