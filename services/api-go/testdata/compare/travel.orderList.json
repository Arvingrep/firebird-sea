{
  "$schema": "./schema.json",
  "service": "travel",
  "action": "orderList",
  "cases": [
    { "name": "正常：默认列表（4 单，含 state0 单的 payurl → ignore 随机盐）", "method": "GET", "params": {}, "requiresLogin": true, "ignoreFields": ["info.list[].payurl"] },
    { "name": "state=1 过滤（仅单1，type1 已付）", "method": "GET", "params": { "state": "1" }, "requiresLogin": true },
    { "name": "state=20（订单2，type3 酒店链）", "method": "GET", "params": { "state": "20" }, "requiresLogin": true },
    { "name": "state=9（订单4，已退款）", "method": "GET", "params": { "state": "9" }, "requiresLogin": true },
    { "name": "分页：pageSize=2&page=1", "method": "GET", "params": { "pageSize": "2", "page": "1" }, "requiresLogin": true, "ignoreFields": ["info.list[].payurl"] },
    { "name": "分页：pageSize=2&page=2", "method": "GET", "params": { "pageSize": "2", "page": "2" }, "requiresLogin": true, "ignoreFields": ["info.list[].payurl"] },
    { "name": "title 搜索（命中单1）", "method": "GET", "params": { "title": "TT2500000001" }, "requiresLogin": true },
    { "name": "空结果：title 无命中", "method": "GET", "params": { "title": "NO-SUCH-ORDER" }, "requiresLogin": true },
    { "name": "商家分支：store=1（s.userid=1，无单）→ pageInfo 空 list", "method": "GET", "params": { "store": "1" }, "requiresLogin": true },
    { "name": "type 过滤：type=3", "method": "GET", "params": { "type": "3" }, "requiresLogin": true },
    { "name": "未登录 → userid=-1 → 空列表", "method": "GET", "params": {} }
  ]
}
