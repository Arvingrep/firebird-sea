{
  "$schema": "./schema.json",
  "service": "travel",
  "action": "common",
  "cases": [
    {
      "name": "正常：newsid=1 顶层 2 行 + lower 递归链（未登录 already=0）",
      "method": "GET",
      "params": {
        "newsid": "1"
      }
    },
    {
      "name": "orderby=hot（good DESC, id DESC）",
      "method": "GET",
      "params": {
        "newsid": "1",
        "orderby": "hot"
      }
    },
    {
      "name": "typeid=0 过滤（原始串拼 SQL）",
      "method": "GET",
      "params": {
        "newsid": "1",
        "typeid": "0"
      }
    },
    {
      "name": "分页 page=2&pageSize=1（pageInfo.page 为 int）",
      "method": "GET",
      "params": {
        "newsid": "1",
        "page": "2",
        "pageSize": "1"
      }
    },
    {
      "name": "newsid=2：1 行 + lower id8 → floor=3 → id4 三层链",
      "method": "GET",
      "params": {
        "newsid": "2"
      }
    },
    {
      "name": "空结果：newsid=0 → 101 暂无数据！",
      "method": "GET",
      "params": {
        "newsid": "0"
      }
    },
    {
      "name": "登录：duser 含 uid → already=1（含子层）",
      "method": "GET",
      "params": {
        "newsid": "1"
      },
      "requiresLogin": true
    },
    {
      "name": "数值字面量：newsid=1e0（MySQL 合法 → aid=1）",
      "method": "GET",
      "params": {
        "newsid": "1e0"
      }
    },
    {
      "name": "数值字面量：newsid=%201%20（首尾空白）",
      "method": "GET",
      "params": {
        "newsid": " 1 "
      }
    }
  ]
}