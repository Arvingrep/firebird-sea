{
  "$schema": "./schema.json",
  "service": "siteConfig",
  "action": "touchHomePageFooter",
  "cases": [
    { "name": "旧版：version 缺省（固定 5 项，不看 module/platform）", "method": "GET", "params": {}, "requiresLogin": false, "ignoreFields": [] },
    { "name": "旧版：version=3.0", "method": "GET", "params": { "version": "3.0", "module": "article" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "2.0：不带 platform（命中后台自定义菜单）", "method": "GET", "params": { "version": "2.0" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "2.0&module=article（自定义 article 菜单）", "method": "GET", "params": { "version": "2.0", "module": "article" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "2.0&module=article&platform=android（platform 关掉自定义菜单 → 硬编码）", "method": "GET", "params": { "version": "2.0", "module": "article", "platform": "android" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "2.0&module=unknownmod（兜底默认菜单）", "method": "GET", "params": { "version": "2.0", "module": "unknownmod" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "2.0&module=paotui（重写成 waimai）", "method": "GET", "params": { "version": "2.0", "module": "paotui" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "2.0&module=cart（重写成 shop + cartNum）", "method": "GET", "params": { "version": "2.0", "module": "cart" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "2.0&module=shop&platform=android（android 折叠成 app）", "method": "GET", "params": { "version": "2.0", "module": "shop", "platform": "android" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "2.0&default=1（跳过自定义菜单）", "method": "GET", "params": { "version": "2.0", "default": "1" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "2.0&module=job（active_N/default_N 图标）", "method": "GET", "params": { "version": "2.0", "module": "job" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "JSONP", "method": "GET", "params": { "version": "2.0", "module": "article", "callback": "jQuery123_456" }, "requiresLogin": false, "ignoreFields": [] }
  ]
}
