{
 "$schema": "./schema.json",
 "service": "travel",
 "action": "addr",
 "cases": [
  {
   "name": "空 type：匿名管理员全量分支（site_city state=1 全量）",
   "method": "GET",
   "params": {}
  },
  {
   "name": "type=1&pageSize=2：site_area 子区域",
   "method": "GET",
   "params": {
    "type": "1",
    "pageSize": "2"
   },
   "ignoreFields": [
    "info[].url",
    "info[].lower"
   ]
  },
  {
   "name": "type=1&son=1：递归子区域",
   "method": "GET",
   "params": {
    "type": "1",
    "son": "1"
   },
   "ignoreFields": [
    "info[].url",
    "info[].lower[].url",
    "info[].lower[].lower[].url",
    "info[].lower[]",
    "info[].lower[].lower[]"
   ]
  },
  {
   "name": "type=999999：无此城市 → 102",
   "method": "GET",
   "params": {
    "type": "999999"
   }
  },
  {
   "name": "type=0 显式传：与空 type 同分支",
   "method": "GET",
   "params": {
    "type": "0"
   }
  }
 ]
}