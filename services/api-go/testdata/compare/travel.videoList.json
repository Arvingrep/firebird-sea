  {
   "name": "search 分词",
   "method": "GET",
   "params": {
    "search": "旅 游"
   }
  },
  {
   "name": "usertype=0",
   "method": "GET",
   "params": {
    "usertype": "0"
   }
  },
  {
   "name": "noid",
   "method": "GET",
   "params": {
    "noid": "1,2"
   }
  },
  {
