{
  "$schema": "./schema.json",
  "service": "article",
  "action": "zhuantiList",
  "cases": [
    { "name": "正常：默认分页", "method": "GET", "params": {}, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：orderby=time", "method": "GET", "params": { "orderby": "time", "pageSize": "5" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：orderby=click + r=1", "method": "GET", "params": { "orderby": "click", "r": "1" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：get_lower + get_news + thumb", "method": "GET", "params": { "get_lower": "1", "get_news": "1", "thumb": "1", "pageSize": "3" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "空结果：typeid 不存在", "method": "GET", "params": { "typeid": "999999" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "空结果：翻页超出（list 为空、pageInfo 仍在）", "method": "GET", "params": { "page": "99999" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "参数错误：r=abc（PHP 视为 flag_r > 0）", "method": "GET", "params": { "r": "abc" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "参数错误：r=1abc（拼进 SQL 报错 → 暂无数据）", "method": "GET", "params": { "r": "1abc" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "参数错误：GET page=-1&pageSize=-5（取默认）", "method": "GET", "params": { "page": "-1", "pageSize": "-5" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "参数错误：POST page=-1（不取默认，LIMIT 报错 → list 空）", "method": "POST", "params": { "page": "-1", "pageSize": "5" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "POST：page=0&pageSize=0（落到默认）", "method": "POST", "params": { "page": "0", "pageSize": "0" }, "requiresLogin": false, "ignoreFields": [] }
  ]
}
