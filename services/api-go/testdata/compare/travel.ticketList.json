{
 "$schema": "./schema.json",
 "service": "travel",
 "action": "ticketList",
 "cases": [
  {
   "name": "默认（空表 → 101 暂无数据）",
   "method": "GET",
   "params": {}
  },
  {
   "name": "rec=1 flag=1（空表 → 101）",
   "method": "GET",
   "params": {
    "rec": "1",
    "flag": "1"
   }
  },
  {
   "name": "business 覆盖 addrid（空表 → 101）",
   "method": "GET",
   "params": {
    "business": "2",
    "addrid": "1"
   }
  },
  {
   "name": "orderby=5 距离 DESC（无坐标 → 空排序，空表 → 101）",
   "method": "GET",
   "params": {
    "orderby": "5"
   }
  },
  {
   "name": "经纬度 + orderby=5",
   "method": "GET",
   "params": {
    "orderby": "5",
    "lng": "120.1",
    "lat": "30.2"
   }
  },
  {
   "name": "orderby=8",
   "method": "GET",
   "params": {
    "orderby": "8"
   }
  }
 ]
}