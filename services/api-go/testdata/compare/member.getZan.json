{
  "$schema": "./schema.json",
  "service": "member",
  "action": "getZan",
  "cases": [
    {
      "name": "未登录：无参数，先撞登录门禁（101 登录超时）",
      "method": "GET",
      "params": {},
      "requiresLogin": false,
      "ignoreFields": []
    },
    {
      "name": "未登录：id/module/temp 齐也无用，仍是登录超时",
      "method": "GET",
      "params": {
        "id": "1",
        "module": "article",
        "temp": "detail"
      },
      "requiresLogin": false,
      "ignoreFields": []
    },
    {
      "name": "未登录：check=0 是假值，照常走门禁",
      "method": "GET",
      "params": {
        "id": "1",
        "module": "article",
        "temp": "detail",
        "check": "0"
      },
      "requiresLogin": false,
      "ignoreFields": []
    },
    {
      "name": "未登录：check=1 探测未赞（no），跳过登录与参数门禁",
      "method": "GET",
      "params": {
        "id": "1",
        "module": "article",
        "temp": "detail",
        "check": "1"
      },
      "requiresLogin": false,
      "ignoreFields": []
    },
    {
      "name": "未登录：check=1 缺 module/temp 也照常探测（no）",
      "method": "GET",
      "params": {
        "id": "1",
        "check": "1"
      },
      "requiresLogin": false,
      "ignoreFields": []
    },
    {
      "name": "未登录：check=abc 任意非空非 0 字符串为真（no）",
      "method": "GET",
      "params": {
        "id": "1",
        "module": "article",
        "temp": "detail",
        "check": "abc"
      },
      "requiresLogin": false,
      "ignoreFields": []
    }
  ]
}