{
  "$schema": "./schema.json",
  "service": "member",
  "action": "getComment",
  "cases": [
    {"name": "正常：article-detail 评论列表（匿名）", "method": "GET", "params": {"type": "article-detail", "aid": "1", "page": "1", "pageSize": "10"}, "requiresLogin": false, "ignoreFields": ["info.list[].ftime", "info.list[].detail.url"]},
    {"name": "正常：son=1 带子评论（H5 资讯详情页调用）", "method": "GET", "params": {"type": "article-detail", "son": "1", "aid": "1", "page": "1", "pageSize": "10"}, "requiresLogin": false, "ignoreFields": ["info.list[].ftime", "info.list[].detail.url", "info.list[].lower.list[].ftime", "info.list[].lower.list[].lower.list[].ftime"]},
    {"name": "正常：orderby=hot", "method": "GET", "params": {"type": "article-detail", "aid": "1", "orderby": "hot"}, "requiresLogin": false, "ignoreFields": ["info.list[].ftime", "info.list[].detail.url"]},
    {"name": "正常：orderby=1 正序 + isAjax=1（pageInfo 为空数组）", "method": "GET", "params": {"type": "article-detail", "aid": "1", "orderby": "1", "isAjax": "1"}, "requiresLogin": false, "ignoreFields": ["info.list[].ftime", "info.list[].detail.url"]},
    {"name": "正常：tieba-detail（where_tieba 不含 pid）", "method": "GET", "params": {"type": "tieba-detail", "aid": "1"}, "requiresLogin": false, "ignoreFields": ["info.list[].ftime", "info.list[].detail.url"]},
    {"name": "正常：filter=pic", "method": "GET", "params": {"type": "article-detail", "aid": "1", "filter": "pic"}, "requiresLogin": false, "ignoreFields": ["info.list[].ftime", "info.list[].detail.url"]},
    {"name": "空结果：aid 不存在", "method": "GET", "params": {"type": "article-detail", "aid": "99999999"}, "requiresLogin": false, "ignoreFields": []},
    {"name": "空结果：page 越界（列表为空数组）", "method": "GET", "params": {"type": "article-detail", "aid": "1", "page": "9999"}, "requiresLogin": false, "ignoreFields": []},
    {"name": "参数错误：type 为空", "method": "GET", "params": {"aid": "1"}, "requiresLogin": false, "ignoreFields": []},
    {"name": "参数错误：aid 为空", "method": "GET", "params": {"type": "article-detail"}, "requiresLogin": false, "ignoreFields": []},
    {"name": "未登录：u=1 userid=-1 拼进 SQL → 空结果", "method": "GET", "params": {"u": "1", "onlyself": "1"}, "requiresLogin": false, "ignoreFields": []},
    {"name": "未登录：u=2 userid=-1 → 空结果", "method": "GET", "params": {"u": "2"}, "requiresLogin": false, "ignoreFields": []}
  ]
}
