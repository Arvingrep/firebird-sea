{
  "$schema": "./schema.json",
  "service": "article",
  "action": "alist",
  "cases": [
    { "name": "正常：默认分页", "method": "GET", "params": {}, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：翻页 page=2&pageSize=5", "method": "GET", "params": { "page": "2", "pageSize": "5" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：typeid=2（含子分类）", "method": "GET", "params": { "typeid": "2", "pageSize": "5" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：title 模糊查询", "method": "GET", "params": { "title": "a" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：mold=1 + group_img（图集）", "method": "GET", "params": { "mold": "1", "group_img": "1", "pageSize": "3" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：orderby=2.1（时间条件只进子查询，totalCount 是全量）", "method": "GET", "params": { "orderby": "2.1" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：orderby=4.1（评论排行：字段列表不含 typeid/source/typeset）", "method": "GET", "params": { "orderby": "4.1" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：media=is（只看有媒体号）", "method": "GET", "params": { "media": "is", "pageSize": "5" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：get_zan=1（输出 zan）", "method": "GET", "params": { "get_zan": "1", "pageSize": "3" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：thumb=1（只取有缩略图）", "method": "GET", "params": { "thumb": "1", "pageSize": "5" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：notid 排除指定 id", "method": "GET", "params": { "notid": "1,2,3", "pageSize": "5" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：isAjax=1（跳过 COUNT、pageInfo 输出空数组）", "method": "GET", "params": { "isAjax": "1", "pageSize": "3" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "正常：u=1 未登录（admin=-1 → 暂无数据）", "method": "GET", "params": { "u": "1" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "空结果：typeid 不存在", "method": "GET", "params": { "typeid": "999999" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "参数错误：flag=zzz（悬空 AND → SQL 报错 → 暂无数据）", "method": "GET", "params": { "flag": "zzz" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "参数错误：media=abc（原样插值 → 暂无数据）", "method": "GET", "params": { "media": "abc" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "参数错误：GET page=-1&pageSize=-5（取默认）", "method": "GET", "params": { "page": "-1", "pageSize": "-5" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "参数错误：POST page=-1（不取默认，LIMIT 报错 → list 空、pageInfo 仍在）", "method": "POST", "params": { "page": "-1", "pageSize": "5" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "POST：page=0&pageSize=0（落到默认）", "method": "POST", "params": { "page": "0", "pageSize": "0" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "JSONP（GET）", "method": "GET", "params": { "callback": "jQuery123_456" }, "requiresLogin": false, "ignoreFields": [] }
  ]
}
