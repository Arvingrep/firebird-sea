{
  "$schema": "./schema.json",
  "service": "siteConfig",
  "action": "siteModule",
  "cases": [
    { "name": "桌面默认：全量（type 空 → type=0）", "method": "GET", "params": {}, "requiresLogin": false, "ignoreFields": [] },
    { "name": "type=0", "method": "GET", "params": { "type": "0" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "type=1（不加 type 过滤）", "method": "GET", "params": { "type": "1" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "参数错误：type=abc", "method": "GET", "params": { "type": "abc" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "page=touchHome（type 强制 1，排除 special/website）", "method": "GET", "params": { "page": "touchHome" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "cityid=1", "method": "GET", "params": { "cityid": "1" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "空结果/无城市配置：cityid=999", "method": "GET", "params": { "cityid": "999" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "参数错误：cityid=abc", "method": "GET", "params": { "cityid": "abc" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "platform=wx_miniprogram（桌面 UA，仍走 pc 分支）", "method": "GET", "params": { "platform": "wx_miniprogram" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "POST 表单 type=1", "method": "POST", "params": { "type": "1" }, "requiresLogin": false, "ignoreFields": [] },
    { "name": "JSONP", "method": "GET", "params": { "callback": "cb" }, "requiresLogin": false, "ignoreFields": [] }
  ]
}
