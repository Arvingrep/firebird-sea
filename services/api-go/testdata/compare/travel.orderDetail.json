{
  "$schema": "./schema.json",
  "service": "travel",
  "action": "orderDetail",
  "cases": [
    { "name": "正常：单1（type1 门票链 + 服务码 + ignore now）", "method": "GET", "params": { "id": "1" }, "requiresLogin": true, "ignoreFields": ["info.now"] },
    { "name": "单2（type3 酒店链 + people JSON 数组）", "method": "GET", "params": { "id": "2" }, "requiresLogin": true, "ignoreFields": ["info.now"] },
    { "name": "单3（type4 签证 + state0 payurl ignore + store=sid2）", "method": "GET", "params": { "id": "3" }, "requiresLogin": true, "ignoreFields": ["info.now", "info.payurl"] },
    { "name": "单4（state9 + travelquan 服务码）", "method": "GET", "params": { "id": "4" }, "requiresLogin": true, "ignoreFields": ["info.now"] },
    { "name": "单5（store=1 卖家即本人：s.userid=1 命中）", "method": "GET", "params": { "id": "5" }, "requiresLogin": true, "ignoreFields": ["info.now"] },
    { "name": "空结果：id=999 → 空数组", "method": "GET", "params": { "id": "999" }, "requiresLogin": true },
    { "name": "参数错误：id=abc", "method": "GET", "params": { "id": "abc" }, "requiresLogin": true },
    { "name": "未登录：userid=-1 → 空数组", "method": "GET", "params": { "id": "1" } }
  ]
}
