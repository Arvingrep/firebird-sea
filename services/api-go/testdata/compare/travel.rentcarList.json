   "params": {
    "addrid": "1"
   }
  },
  {
   "name": "price 区间",
   "method": "GET",
   "params": {
    "price": "50,100"
   }
  },
  {
   "name": "orderby=3（空表 → 101）",
   "method": "GET",
   "params": {
    "orderby": "3"
   }
  },
  {
   "name": "state=1 会员态过滤（requiresLogin，u=1，无店 → 1=2 → 101）",
   "method": "GET",
   "params": {
    "u": "1",
    "state": "1"
   },
