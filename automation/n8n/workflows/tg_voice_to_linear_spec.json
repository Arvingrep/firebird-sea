{
  "id": "WkFtg2gh00000005",
  "name": "一人AI团队：TG语音与随笔自动提炼TaskSpec",
  "active": true,
  "versionId": "f7f4ba05-7d12-7656-d8f7-c0b9491ee71d",
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  },
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "id": "node-tg-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "model": "gemini-2.5-flash",
        "prompt": "=你是负责架构与任务转化的首席秘书。请分析以下老板在TG发送的语音转录或随笔：\n\n\"{{ $json.message.text }}\"\n\n请提取为标准 JSON 格式：\n{\n  \"title\": \"简洁任务标题\",\n  \"module\": \"FOOD_DELIVERY|ERRANDS|HOUSING|JOBS|PAYMENT|DEVOPS\",\n  \"priority\": \"HIGH|MEDIUM|LOW\",\n  \"description\": \"详细需求说明\",\n  \"acceptance_criteria\": [\"AC 1...\", \"AC 2...\"]\n}"
      },
      "id": "node-ai-spec-extractor",
      "name": "AI 提取结构化 Spec",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "title": "={{ $json.output.title }}",
        "description": "={{ $json.output.description }}\n\n### 验收标准 (AC):\n{{ $json.output.acceptance_criteria.join('\\n') }}"
      },
      "id": "node-linear-create",
      "name": "Linear 自动创建 Task",
      "type": "n8n-nodes-base.linear",
      "typeVersion": 1,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=✅ 任务已由 AI 解析并自动推入任务池：\n\n📌 *{{ $json.title }}*\n⚡ 模块: {{ $json.team.name }}\n🔗 任务链接: {{ $json.url }}\n\nAI Agent 可以随时通过编号开展编码！",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "node-tg-reply",
      "name": "回传 TG 任务确认卡片",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        950,
        300
      ]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "AI 提取结构化 Spec",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI 提取结构化 Spec": {
      "main": [
        [
          {
            "node": "Linear 自动创建 Task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Linear 自动创建 Task": {
      "main": [
        [
          {
            "node": "回传 TG 任务确认卡片",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
