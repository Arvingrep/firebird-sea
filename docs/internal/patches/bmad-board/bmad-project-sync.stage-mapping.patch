# 【草案,须 Arvin 本人提交】对现有 .github/workflows/bmad-project-sync.yml 的改动:
# PR merged 后面板状态设为 ready-to-release(🚀 待发布上线),不再直接 done;
# done 只由 Issue closed 或手动 workflow_dispatch 触发(上线确认后)。
--- a/.github/workflows/bmad-project-sync.yml
+++ b/.github/workflows/bmad-project-sync.yml
@@ -40,7 +40,7 @@
             pull_request:opened) URL="$PR_URL"; STAGE=in-qa ;;
             pull_request:closed)
               [ "$PR_MERGED" = "true" ] || exit 0
-              URL="$PR_URL"; STAGE=done ;;
+              URL="$PR_URL"; STAGE=ready-to-release ;;
             workflow_dispatch:*) URL="$INPUT_URL"; STAGE="$INPUT_STAGE" ;;
             *) exit 0 ;;
           esac
