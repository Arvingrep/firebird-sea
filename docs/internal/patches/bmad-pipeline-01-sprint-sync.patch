diff --git a/.github/workflows/bmad-sprint-sync.yml b/.github/workflows/bmad-sprint-sync.yml
new file mode 100644
index 00000000..395fa56c
--- /dev/null
+++ b/.github/workflows/bmad-sprint-sync.yml
@@ -0,0 +1,48 @@
+name: BMAD Sprint 状态回写
+
+# agent/issue-N 的 PR：打开 → review；合并 → done。回写 _bmad-output/.../sprint-status.yaml 并直推 main。
+# 只读 Issue 正文里的 <!-- bmad-story: KEY --> 标记；没有标记（非 BMAD Story）则静默跳过。
+on:
+  pull_request:
+    types: [opened, reopened, closed]
+    branches: [main]
+
+permissions:
+  contents: read
+
+concurrency:
+  group: bmad-sprint-sync
+  cancel-in-progress: false
+
+jobs:
+  sync:
+    if: >-
+      startsWith(github.head_ref, 'agent/issue-') &&
+      github.event.pull_request.head.repo.full_name == github.repository &&
+      (github.event.action != 'closed' || github.event.pull_request.merged == true)
+    runs-on: ubuntu-latest
+    env:
+      GH_TOKEN: ${{ secrets.AGENT_GH_TOKEN }}
+      HEAD_REF: ${{ github.head_ref }}
+      ACTION: ${{ github.event.action }}
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: main
+          token: ${{ secrets.AGENT_GH_TOKEN }}   # 需要推送；PAT 推的提交不会再触发本 workflow（仅 PR 事件）
+      - name: 回写 sprint-status
+        run: |
+          set -euo pipefail
+          N="${HEAD_REF#agent/issue-}"
+          [[ "$N" =~ ^[0-9]+$ ]] || exit 0
+          KEY="$(gh issue view "$N" --json body -q .body | grep -oE '<!-- bmad-story: [^ ]+ -->' | head -n1 | awk '{print $3}')"
+          [[ "$KEY" =~ ^[0-9]+-[0-9]+-[^[:space:]]+$ ]] || { echo "Issue #$N 不是 BMAD Story，跳过"; exit 0; }
+          FILE=_bmad-output/implementation-artifacts/sprint-status.yaml
+          [ -f "$FILE" ] || { echo "main 上没有 $FILE，跳过"; exit 0; }
+          STATUS=review; [ "$ACTION" = closed ] && STATUS=done
+          node scripts/bmad/sync-sprint-status.js "$KEY" "$STATUS" --file "$FILE"
+          git diff --quiet && exit 0
+          git config user.name "firebird-agent"; git config user.email "agent@users.noreply.github.com"
+          git commit -qam "chore(bmad): ${KEY} -> ${STATUS} [skip ci]"
+          for _ in 1 2 3; do git push -q origin HEAD:main && exit 0; git pull -q --rebase origin main; done
+          exit 1
